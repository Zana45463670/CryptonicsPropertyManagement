@model IEnumerable<CryptonicsPropertyManagement.Models.Entities.Property>
@{
    ViewData["Title"] = "Properties";
}

<h2>Properties</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Description</th>
            <th>Address</th>
            <th>Owner</th>
            <th>Monthly Rent</th>
            <th>Vacant?</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.PropertyId</td>
            <td>@item.PropertyDescription</td>
            <td>@item.PhysicalAddress</td>
            <td>@item.Owner?.FullName</td>
            <td>R @item.MonthlyRent.ToString("N2")</td>
            <td>@(item.VacancyStatus ? "Yes" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PropertyId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.PropertyId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
