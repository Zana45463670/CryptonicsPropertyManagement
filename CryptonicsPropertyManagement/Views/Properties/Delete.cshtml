@model CryptonicsPropertyManagement.Models.Entities.Property
@{
    ViewData["Title"] = "Delete Property";
}

<h2>Delete Property</h2>
<div class="alert alert-warning">
    Are you sure you want to delete this property?
</div>
<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.PropertyId</dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.PhysicalAddress</dd>
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.Owner?.FullName</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="PropertyId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
