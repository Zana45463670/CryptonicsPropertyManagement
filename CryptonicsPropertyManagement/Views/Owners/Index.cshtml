@model IEnumerable<CryptonicsPropertyManagement.Models.Entities.Owner>
@{
    ViewData["Title"] = "Owners";
}

<h2>Owners</h2>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<p><a asp-action="Create" class="btn btn-primary">Create New</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.OwnerId</td>
            <td>@item.FullName</td>
            <td>@item.EmailAddress</td>
            <td>@item.PhoneNumber</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.OwnerId">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.OwnerId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
